{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessplayground",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "chessplayground.app",
      "custom_domain": true
    }
  ]
}
