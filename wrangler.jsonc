{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessplayground",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "chessplayground.app",
      "custom_domain": true,
    },
  ],
}
