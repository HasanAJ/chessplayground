{
  "name": "tempo-chess-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/copy-engine.mjs",
    "test": "node --import tsx --test tests/*/*.test.ts",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "format": "prettier --write src scripts tests *.ts *.json README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json README.md"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "26.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0",
    "npm": "10.9.9"
  }
}
